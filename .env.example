# Agent Kanban Board — example environment.
# Copy to .env and fill in real values. NEVER commit a real token.
# Server (see docs/CONFIGURATION.md for the full reference)

# --- Core ---
PORT=4000
HOST=127.0.0.1
KANBAN_DEFAULT_PROJECT=default
KANBAN_DATA_DIR=/data
KANBAN_DATA_FILE=/data/tasks.json
KANBAN_STORAGE_BACKEND=json
# Production MUST set one or more explicit origins here. The localhost value is
# a development default only; leaving it uncommented in a copied sample would
# defeat the production CORS guard (D8), so it is commented out on purpose.
# KANBAN_ALLOWED_ORIGIN=http://localhost:5173
# NODE_ENV=production refuses to boot without an explicit allowlist unless this
# is "1" (accept the localhost development default deliberately).
KANBAN_ALLOW_DEV_CORS=
# v3.12.6: POST /api/tasks retry safety. A successful create is replayed for
# an Idempotency-Key header within this TTL; the map is capped (oldest evicted).
KANBAN_IDEMPOTENCY_TTL_MS=600000
KANBAN_IDEMPOTENCY_MAX_ENTRIES=1000

# --- Auth (mutations are fail-closed 503 until one is set) ---
KANBAN_AUTH_TOKEN=change-me-shared
# Admin credential: required (or a privileged session) for delete, purge and
# trash restore/hard-delete in every auth mode. Without it, those return 403.
# Must differ from KANBAN_AUTH_TOKEN and every project credential (startup refuses otherwise).
KANBAN_ADMIN_TOKEN=change-me-admin
# Per-project credentials, or leave EMPTY. A non-JSON value here (e.g. "change-me")
# makes every mutation fail closed with 503 — the server cannot parse it into a
# token map. v3.8.0+ binds each AGENT ROLE to its own credential; v3.12.8 also
# binds the AGENT IDENTITY (A7):
#   "tok-a" (legacy string) or {"token":"tok-a"}          → unbound, header role/identity kept
#   {"token":"tok-b","role":"builder"}                    → role-bound (forced server-side)
#   {"token":"tok-c","agent_id":"agent-7"}                → identity-bound (headers cannot spoof it)
#   {"token":"tok-d","role":"tester","agent_id":"t-1"}    → both bound
#   {"credentials":[{...},...]}                           → several credentials per project
# agent_id must be 1-64 chars from [A-Za-z0-9._@:/-]. One token bound to two
# different agent ids across projects is rejected (identity would change with scope).
# Every agent role needs its own token: planner, builder, reviewer, tester, releaser.
# Privileged roles (runner/system/human/admin) are never bound — the admin token
# (or a session) confers them. Header-declared X-Agent-Id/X-Agent-Role still works
# only for unbound credentials; a conflicting declaration on a bound credential is
# ignored + audited (identity_binding_mismatch / role_binding_mismatch). A body
# agent_id is NOT identity for a non-privileged caller (A7).
KANBAN_PROJECT_TOKENS=
# Example: KANBAN_PROJECT_TOKENS={"myapp":{"credentials":[{"token":"tok-p","role":"planner"},{"token":"tok-b","role":"builder","agent_id":"agent-7"},{"token":"tok-r","role":"reviewer"},{"token":"tok-t","role":"tester"},{"token":"tok-release","role":"releaser"}]}}
KANBAN_AUTH_SECRET=change-me
# Single-use session handshake challenge (A5). TTL of a challenge nonce
# (default 120000), and the proof mode. The default is "required":
# POST /api/auth/session needs a fresh server_nonce from POST /api/auth/challenge.
# Only the exact value "legacy" accepts the old challenge-less proof (temporary
# opt-out for old clients; logged as a startup warning).
KANBAN_SESSION_CHALLENGE_TTL_MS=
KANBAN_SESSION_NONCE_MODE=
KANBAN_READ_AUTH=off
KANBAN_AUTH_LOG=
KANBAN_AUTH_RATE_LIMIT_PER_MIN=

# --- Rate limiting ---
KANBAN_RATE_LIMIT_PER_MIN=
KANBAN_RATE_LIMIT_WINDOW_MS=60000

# --- Leases / reaper ---
KANBAN_CLAIM_TTL_MS=600000
KANBAN_MIN_LEASE_MS=60000
KANBAN_MAX_LEASE_MS=7200000
KANBAN_HOLDER_WRITE_RENEWS_ALL=1
# v2.12.1: cap on active claims per agent (0/unset = unlimited). Privileged
# roles (runner/system/human/admin) are exempt.
KANBAN_MAX_CLAIMS_PER_AGENT=0
KANBAN_ORPHAN_GRACE_MS=300000
KANBAN_PROGRESS_STALL_MS=1800000
KANBAN_REAP_ENABLED=1
# <= 0 disables the reaper (and /api/health then reports `degraded`).
KANBAN_REAP_INTERVAL_MS=30000
KANBAN_AUTO_PROMOTE=1

# --- Archive / trash ---
KANBAN_ARCHIVE_AFTER_DAYS=30
KANBAN_ARCHIVING_DISABLED=
KANBAN_TRASH_DAYS=30

# --- Storage tuning ---
KANBAN_STORAGE_JOURNAL=0
KANBAN_JOURNAL_COMPACT_BYTES=1048576
KANBAN_INLINE_LOG_CAP=50
KANBAN_INLINE_COMMENT_CAP=50

# --- SSE ---
KANBAN_MAX_SSE_STREAMS=100
KANBAN_MAX_SSE_STREAMS_PER_IP=20

# --- Credentials ---
# 1 = reject writes from credentials without an agent_id binding (default off)
KANBAN_REQUIRE_BOUND_CREDENTIALS=0

# --- Backups ---
KANBAN_BACKUP_ENABLED=1
KANBAN_BACKUP_INTERVAL_MS=600000
KANBAN_BACKUP_KEEP=10

# --- Audit stream ---
KANBAN_AUDIT_LOG=

# --- role_crossing audit signal (ADR-006) ---
# Set truthy to emit a `role_crossing` audit event when ONE agent presents
# bound credentials for SEVERAL roles on a project. A crossing is a review
# prompt, not a violation — it never blocks a request. OFF by default: a
# deployment whose agents legitimately hold several role-bound credentials
# would otherwise emit an event on every such mutation.
KANBAN_ROLE_CROSSING_AUDIT=

# --- Telegram reclaim alerts ---
KANBAN_TELEGRAM_BOT_TOKEN=change-me
KANBAN_TELEGRAM_CHAT_ID=change-me
KANBAN_BOARD_URL=https://agent-kanban.riazrahaman.com
KANBAN_NOTIFY_EVENTS=lease_expired,orphan_normalized
KANBAN_NOTIFY_PROJECTS=
KANBAN_NOTIFY_INCLUDE_DESC=1
KANBAN_NOTIFY_MIN_INTERVAL_MS=1000

# --- Git backend ---
KANBAN_GIT_DIR=
KANBAN_GIT_COMMIT=1

# --- Reverse proxy (client IP for the bug-report rate limiter) ---
# Unset (default) = trust no proxy: X-Forwarded-For is ignored. Right for a
# directly exposed board. Behind a single reverse proxy (e.g. Railway's edge)
# set KANBAN_TRUST_PROXY=1; otherwise every client shares the proxy's address.
# Also accepts 0/false (none), true (all hops), or an address/CIDR list.
# KANBAN_TRUST_PROXY=1

# --- Report-a-bug -> GitHub issue (OFF unless the first four are set) ---
# See README.md "Enabling Report-a-bug" for where to get each value.
KANBAN_REPORT_GITHUB_TOKEN=change-me
KANBAN_REPORT_REPO=owner/name
TURNSTILE_SECRET=change-me
TURNSTILE_SITE_KEY=change-me
TURNSTILE_HOSTNAMES=
KANBAN_REPORT_DAILY_CAP=50
KANBAN_REPORT_PER_IP_PER_HOUR=3
KANBAN_REPORT_GITHUB_API_URL=https://api.github.com

# --- Deploy drift (on by default; reports only, never blocks) ---
# Compares the RUNNING version with the newest published version. A Railway
# service with `checkSuites: true` SKIPS a deploy when CI is red and keeps
# serving the previous build, so this is what makes a skipped release visible in
# /api/health (`deploy_drift`) and on Telegram. Set the interval to 0 to disable.
# Drift means only that the running build is BEHIND; a build AHEAD of the newest
# release is `in_sync`, and a mismatch is only called `drift` after the grace
# window below. The version comparison is semver, not string equality.
KANBAN_DEPLOY_DRIFT_INTERVAL_MS=1800000
KANBAN_DEPLOY_DRIFT_GRACE_MS=2700000
# Optional: point at another release feed (tests / a fork). The tags endpoint is
# derived from this URL (/releases/latest -> /tags?per_page=100) unless the
# variable below overrides it.
KANBAN_DEPLOY_DRIFT_API_URL=https://api.github.com/repos/riazrahaman/agent-kanban-board/releases/latest
# Optional: the tag list used when the release feed is missing or older than the
# newest tag (e.g. tags published without GitHub Releases). Defaults to the tags
# endpoint of the same repository as the release feed above.
KANBAN_DEPLOY_DRIFT_TAGS_API_URL=https://api.github.com/repos/riazrahaman/agent-kanban-board/tags?per_page=100

# --- Ask the Board (OFF unless password and provider credentials are set) ---
# Read-only Q&A over the board's protocol + source. POST /api/ask requires the
# x-ask-pass header to equal KANBAN_ASK_PASSWORD. See docs/CONFIGURATION.md.
# Provider: 'openrouter' (default, requires KANBAN_ASK_OPENROUTER_API_KEY) or 'ollama' (local/Tailscale/tunnel).
KANBAN_ASK_PROVIDER=openrouter
KANBAN_ASK_OLLAMA_HOST=http://localhost:11434
KANBAN_ASK_OLLAMA_AUTH_HEADER=
# Optional READ-ONLY GitHub token for Ask's commit-history lookup (unset = unauthenticated)
KANBAN_ASK_GITHUB_TOKEN=
KANBAN_ASK_OPENROUTER_API_KEY=change-me
KANBAN_ASK_PASSWORD=change-me
KANBAN_ASK_MODEL=openai/gpt-oss-20b
KANBAN_ASK_DAILY_CAP=50
KANBAN_ASK_PER_IP_PER_HOUR=3
KANBAN_ASK_TIMEOUT_MS=45000
# Prompt budget for the hosted provider. Ignored for a local Ollama (loopback
# host, model without a ':cloud' suffix): no prompt budget is applied there.
KANBAN_ASK_MAX_PROMPT_TOKENS=24000
KANBAN_ASK_MAX_OUTPUT_TOKENS=1500
# Card text (agent_logs, comments) is redacted before it reaches the model:
# credential-shaped values become [redacted]. Set 'raw' to send it verbatim —
# only on a board whose cards you would paste into a public chat.
KANBAN_ASK_INCLUDE_LOGS=redacted
# Optional: limit the Ask snapshot to these projects (comma-separated).
# Unset = every project — the Ask password is an owner credential over the whole
# board. Set it only if you share the password and want a narrower view.
KANBAN_ASK_SNAPSHOT_PROJECTS=

# --- Outbound webhooks (OFF unless KANBAN_WEBHOOK_URLS is set) ---
# Every committed mutation kind is POSTed as JSON (HMAC-signed when a secret is
# set). Delivery never blocks a board write. Transient failures (network throw/
# timeout, 408, 425, 429, 5xx) retry with exponential backoff; terminal failures
# land in an in-memory per-URL dead-letter ring. See docs/CONFIGURATION.md.
KANBAN_WEBHOOK_URLS=
KANBAN_WEBHOOK_EVENTS=
KANBAN_WEBHOOK_SECRET=
KANBAN_WEBHOOK_MAX_ATTEMPTS=3
# Base retry backoff in ms: 250 -> 250ms, 1s, 4s. 0 disables waiting.
KANBAN_WEBHOOK_BACKOFF_MS=250
# Per-URL queue cap; beyond it the OLDEST queued event is dropped.
KANBAN_WEBHOOK_MAX_QUEUE=100
KANBAN_WEBHOOK_DEAD_LETTER_MAX=50

# Client (Vite)
VITE_API_BASE=/api
VITE_PORT=5173
